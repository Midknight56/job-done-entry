// Local development without Workers AI: `npm run dev:local`. The model is replaced by src/agent/devstub.js
// (MODEL_STUB=1 in .dev.vars); PayPal sandbox calls are real. Nothing here is deployed.
{
  "name": "job-done-local",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "public", "binding": "ASSETS", "run_worker_first": ["/api/*", "/webhooks/*", "/health"] },
  "kv_namespaces": [{ "binding": "JOBDONE", "id": "00000000000000000000000000000000" }],
  "durable_objects": { "bindings": [{ "name": "WORKSPACE", "class_name": "WorkspaceDO" }, { "name": "CAPS", "class_name": "CapsDO" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["WorkspaceDO"] }, { "tag": "v2", "new_sqlite_classes": ["CapsDO"] }],
  "vars": { "APP_NAME": "job-done", "PAYPAL_REMINDER_EVERY_DAYS": "3", "PAYPAL_REMINDER_TIMES": "3", "PAYPAL_REMINDERS_SINCE": "2026-10-28T21:05:00Z" }
}
